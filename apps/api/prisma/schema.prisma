  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

// =============================================================================================
// Phase 05 — shifts, attendance and leave
// =============================================================================================

enum PunchDirection {
  IN
  OUT

  @@map("punch_direction")
}

enum PunchSource {
  WEB
  MOBILE
  QR
  BIOMETRIC_IMPORT
  MANUAL

  @@map("punch_source")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("request_status")
}

enum AccrualMethod {
  NONE
  YEARLY
  MONTHLY

  @@map("accrual_method")
}

enum LeaveSession {
  FULL
  FIRST_HALF
  SECOND_HALF

  @@map("leave_session")
}

enum LeaveLedgerEntryType {
  OPENING
  ACCRUAL
  ADJUSTMENT
  USAGE
  REVERSAL
  CARRY_FORWARD
  LAPSE

  @@map("leave_ledger_entry_type")
}

/// Per-organization time & attendance settings.
model TimeSettings {
  organizationId      String   @id @map("organization_id") @db.Uuid
  leaveYearStartMonth Int      @default(1) @map("leave_year_start_month") @db.SmallInt
  webPunchEnabled     Boolean  @default(true) @map("web_punch_enabled")
  mobilePunchEnabled  Boolean  @default(true) @map("mobile_punch_enabled")
  qrPunchEnabled      Boolean  @default(true) @map("qr_punch_enabled")
  geolocationRequired Boolean  @default(false) @map("geolocation_required")
  qrRotationSeconds   Int      @default(30) @map("qr_rotation_seconds") @db.SmallInt
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("time_settings")
}

model Shift {
  id                   String       @id @default(uuid(7)) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  code                 String       @db.VarChar(20)
  name                 String       @db.VarChar(100)
  /// Local minutes after midnight; end ≤ start crosses midnight.
  startMinutes         Int          @map("start_minutes") @db.SmallInt
  endMinutes           Int          @map("end_minutes") @db.SmallInt
  breakMinutes         Int          @default(0) @map("break_minutes") @db.SmallInt
  graceInMinutes       Int          @default(0) @map("grace_in_minutes") @db.SmallInt
  graceOutMinutes      Int          @default(0) @map("grace_out_minutes") @db.SmallInt
  fullDayMinutes       Int          @map("full_day_minutes") @db.SmallInt
  halfDayMinutes       Int          @map("half_day_minutes") @db.SmallInt
  overtimeAfterMinutes Int?         @map("overtime_after_minutes") @db.SmallInt
  windowBeforeMinutes  Int          @default(240) @map("window_before_minutes") @db.SmallInt
  windowAfterMinutes   Int          @default(360) @map("window_after_minutes") @db.SmallInt
  isDefault            Boolean      @default(false) @map("is_default")
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments   ShiftAssignment[]
  rosterEntries RosterEntry[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("shifts")
}

/// Effective-dated shift of an employee (non-overlapping per employee).
model ShiftAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  shiftId        String    @map("shift_id") @db.Uuid
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)
  shift    Shift    @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, shiftId])
  @@map("shift_assignments")
}

/// Day-specific override: a shift, or a day off when `shift_id` is NULL.
model RosterEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  date           DateTime @db.Date
  shiftId        String?  @map("shift_id") @db.Uuid
  note           String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@map("roster_entries")
}

/// Raw clock events (append-only).
model AttendancePunch {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  employeeId       String         @map("employee_id") @db.Uuid
  punchedAt        DateTime       @map("punched_at") @db.Timestamptz(6)
  direction        PunchDirection
  source           PunchSource
  latitude         Decimal?       @db.Decimal(9, 6)
  longitude        Decimal?       @db.Decimal(9, 6)
  ipAddress        String?        @map("ip_address") @db.Inet
  deviceLabel      String?        @map("device_label") @db.VarChar(100)
  branchId         String?        @map("branch_id") @db.Uuid
  note             String?        @db.VarChar(500)
  recordedByUserId String?        @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([employeeId, punchedAt, direction])
  @@index([organizationId, employeeId, punchedAt])
  @@index([organizationId, punchedAt])
  @@map("attendance_punches")
}

model AttendanceRegularization {
  id                String        @id @default(uuid(7)) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  employeeId        String        @map("employee_id") @db.Uuid
  date              DateTime      @db.Date
  requestedIn       DateTime      @map("requested_in") @db.Timestamptz(6)
  requestedOut      DateTime      @map("requested_out") @db.Timestamptz(6)
  reason            String        @db.VarChar(500)
  status            RequestStatus @default(PENDING)
  requestedByUserId String?       @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?       @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?       @map("decision_note") @db.VarChar(500)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, employeeId, date])
  @@index([organizationId, status])
  @@map("attendance_regularizations")
}

model LeaveType {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  code                 String           @db.VarChar(20)
  name                 String           @db.VarChar(100)
  description          String?          @db.VarChar(500)
  isPaid               Boolean          @default(true) @map("is_paid")
  tracksBalance        Boolean          @default(true) @map("tracks_balance")
  accrualMethod        AccrualMethod    @default(YEARLY) @map("accrual_method")
  annualQuota          Decimal          @default(0) @map("annual_quota") @db.Decimal(6, 2)
  prorateOnJoining     Boolean          @default(false) @map("prorate_on_joining")
  carryForwardMax      Decimal?         @map("carry_forward_max") @db.Decimal(6, 2)
  allowNegativeBalance Boolean          @default(false) @map("allow_negative_balance")
  allowHalfDay         Boolean          @default(true) @map("allow_half_day")
  countWeeklyOffs      Boolean          @default(false) @map("count_weekly_offs")
  countHolidays        Boolean          @default(false) @map("count_holidays")
  minNoticeDays        Int              @default(0) @map("min_notice_days") @db.SmallInt
  maxConsecutiveDays   Decimal?         @map("max_consecutive_days") @db.Decimal(6, 2)
  allowDuringProbation Boolean          @default(true) @map("allow_during_probation")
  employmentTypes      EmploymentType[] @default([]) @map("employment_types")
  status               RecordStatus     @default(ACTIVE)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requests      LeaveRequest[]
  ledgerEntries LeaveLedgerEntry[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("leave_types")
}

model LeaveRequest {
  id                 String        @id @default(uuid(7)) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  employeeId         String        @map("employee_id") @db.Uuid
  leaveTypeId        String        @map("leave_type_id") @db.Uuid
  startDate          DateTime      @map("start_date") @db.Date
  endDate            DateTime      @map("end_date") @db.Date
  startSession       LeaveSession  @default(FULL) @map("start_session")
  endSession         LeaveSession  @default(FULL) @map("end_session")
  days               Decimal       @db.Decimal(6, 2)
  reason             String?       @db.VarChar(1000)
  status             RequestStatus @default(PENDING)
  /// Reporting manager at the time of the request (routing), if any.
  approverEmployeeId String?       @map("approver_employee_id") @db.Uuid
  requestedByUserId  String?       @map("requested_by_user_id") @db.Uuid
  decidedByUserId    String?       @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?       @map("decision_note") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee           @relation("LeaveRequests", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  leaveType LeaveType          @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict)
  approver  Employee?          @relation("LeaveApprovals", fields: [approverEmployeeId], references: [id], onDelete: SetNull)
  ledger    LeaveLedgerEntry[]

  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status])
  @@index([organizationId, approverEmployeeId, status])
  @@map("leave_requests")
}

/// Leave balance ledger (append-only): balance = sum of `days` per employee/type/year.
model LeaveLedgerEntry {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  leaveTypeId     String               @map("leave_type_id") @db.Uuid
  year            Int                  @db.SmallInt
  entryType       LeaveLedgerEntryType @map("entry_type")
  /// Accrual period (1–12; 0 = yearly grant); 0 for other entry types.
  period          Int                  @default(0) @db.SmallInt
  days            Decimal              @db.Decimal(6, 2)
  effectiveDate   DateTime             @map("effective_date") @db.Date
  leaveRequestId  String?              @map("leave_request_id") @db.Uuid
  note            String?              @db.VarChar(500)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  employee     Employee      @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  leaveType    LeaveType     @relation(fields: [organizationId, leaveTypeId], references: [organizationId, id], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, leaveTypeId, year])
  @@map("leave_ledger_entries")
}

// =============================================================================================
// Phase 06 — recruitment and onboarding
// =============================================================================================

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  FILLED

  @@map("requisition_status")
}

enum OpeningStatus {
  DRAFT
  PUBLISHED
  ON_HOLD
  CLOSED

  @@map("opening_status")
}

enum ApplicationStage {
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN

  @@map("application_stage")
}

enum CandidateSource {
  CAREER_PORTAL
  REFERRAL
  AGENCY
  DIRECT
  OTHER

  @@map("candidate_source")
}

enum InterviewMode {
  IN_PERSON
  VIDEO
  PHONE

  @@map("interview_mode")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("interview_status")
}

enum Recommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO

  @@map("recommendation")
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@map("offer_status")
}

enum OnboardingAssignee {
  HR
  MANAGER
  EMPLOYEE
  IT

  @@map("onboarding_assignee")
}

enum OnboardingPlanStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("onboarding_plan_status")
}

enum OnboardingTaskStatus {
  PENDING
  DONE
  SKIPPED

  @@map("onboarding_task_status")
}

model JobRequisition {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  title             String            @db.VarChar(200)
  companyId         String            @map("company_id") @db.Uuid
  departmentId      String?           @map("department_id") @db.Uuid
  branchId          String?           @map("branch_id") @db.Uuid
  designationId     String?           @map("designation_id") @db.Uuid
  employmentType    EmploymentType    @map("employment_type")
  headcount         Int               @default(1) @db.SmallInt
  targetDate        DateTime?         @map("target_date") @db.Date
  justification     String?           @db.VarChar(2000)
  budgetMin         Decimal?          @map("budget_min") @db.Decimal(14, 2)
  budgetMax         Decimal?          @map("budget_max") @db.Decimal(14, 2)
  currency          String            @default("INR") @db.Char(3)
  status            RequisitionStatus @default(DRAFT)
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?           @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?           @map("decision_note") @db.VarChar(1000)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict)
  openings     JobOpening[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("job_requisitions")
}

model JobOpening {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  requisitionId      String?        @map("requisition_id") @db.Uuid
  title              String         @db.VarChar(200)
  slug               String         @db.VarChar(80)
  companyId          String         @map("company_id") @db.Uuid
  departmentId       String?        @map("department_id") @db.Uuid
  branchId           String?        @map("branch_id") @db.Uuid
  location           String?        @db.VarChar(200)
  employmentType     EmploymentType @map("employment_type")
  description        String
  requirements       String?
  experienceMinYears Int?           @map("experience_min_years") @db.SmallInt
  experienceMaxYears Int?           @map("experience_max_years") @db.SmallInt
  salaryMin          Decimal?       @map("salary_min") @db.Decimal(14, 2)
  salaryMax          Decimal?       @map("salary_max") @db.Decimal(14, 2)
  currency           String         @default("INR") @db.Char(3)
  showSalary         Boolean        @default(false) @map("show_salary")
  positions          Int            @default(1) @db.SmallInt
  hiringManagerId    String?        @map("hiring_manager_id") @db.Uuid
  status             OpeningStatus  @default(DRAFT)
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(6)
  closesOn           DateTime?      @map("closes_on") @db.Date
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requisition   JobRequisition?  @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  company       Company          @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch        Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  hiringManager Employee?        @relation("HiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  applications  JobApplication[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("job_openings")
}

model Candidate {
  id                    String          @id @default(uuid(7)) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  firstName             String          @map("first_name") @db.VarChar(100)
  lastName              String?         @map("last_name") @db.VarChar(100)
  email                 String          @db.Citext
  phone                 String?         @db.VarChar(25)
  currentCompany        String?         @map("current_company") @db.VarChar(200)
  currentTitle          String?         @map("current_title") @db.VarChar(200)
  totalExperienceMonths Int?            @map("total_experience_months") @db.SmallInt
  location              String?         @db.VarChar(200)
  skills                String[]        @default([])
  source                CandidateSource @default(DIRECT)
  sourceDetail          String?         @map("source_detail") @db.VarChar(200)
  notes                 String?         @db.VarChar(5000)
  /// When the candidate agreed to the processing of their data (career portal).
  consentAt             DateTime?       @map("consent_at") @db.Timestamptz(6)
  resumeStorageKey      String?         @unique @map("resume_storage_key") @db.VarChar(500)
  resumeFileName        String?         @map("resume_file_name") @db.VarChar(255)
  resumeContentType     String?         @map("resume_content_type") @db.VarChar(100)
  resumeSizeBytes       Int?            @map("resume_size_bytes")
  resumeSha256          String?         @map("resume_sha256") @db.Char(64)
  employeeId            String?         @unique @map("employee_id") @db.Uuid
  createdByUserId       String?         @map("created_by_user_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee?        @relation("HiredCandidate", fields: [employeeId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("candidates")
}

model JobApplication {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  candidateId     String           @map("candidate_id") @db.Uuid
  openingId       String           @map("opening_id") @db.Uuid
  stage           ApplicationStage @default(APPLIED)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  coverLetter     String?          @map("cover_letter") @db.VarChar(5000)
  appliedAt       DateTime         @default(now()) @map("applied_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate   Candidate          @relation(fields: [organizationId, candidateId], references: [organizationId, id], onDelete: Restrict)
  opening     JobOpening         @relation(fields: [organizationId, openingId], references: [organizationId, id], onDelete: Restrict)
  events      ApplicationEvent[]
  assessments Assessment[]
  interviews  Interview[]
  offers      Offer[]

  @@unique([candidateId, openingId])
  @@unique([organizationId, id])
  @@index([organizationId, openingId, stage])
  @@map("job_applications")
}

/// Stage history (append-only).
model ApplicationEvent {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  applicationId  String            @map("application_id") @db.Uuid
  fromStage      ApplicationStage? @map("from_stage")
  toStage        ApplicationStage  @map("to_stage")
  note           String?           @db.VarChar(1000)
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  application JobApplication @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, applicationId, createdAt])
  @@map("application_events")
}

model Assessment {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  applicationId   String   @map("application_id") @db.Uuid
  name            String   @db.VarChar(200)
  score           Decimal  @db.Decimal(8, 2)
  maxScore        Decimal  @map("max_score") @db.Decimal(8, 2)
  assessedOn      DateTime @map("assessed_on") @db.Date
  notes           String?  @db.VarChar(2000)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application JobApplication @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, applicationId])
  @@map("assessments")
}

model Interview {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  roundName       String          @map("round_name") @db.VarChar(100)
  scheduledAt     DateTime        @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int             @map("duration_minutes") @db.SmallInt
  mode            InterviewMode
  locationOrLink  String?         @map("location_or_link") @db.VarChar(500)
  status          InterviewStatus @default(SCHEDULED)
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  application JobApplication      @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Cascade)
  panel       InterviewPanelist[]

  @@unique([organizationId, id])
  @@index([organizationId, scheduledAt])
  @@map("interviews")
}

model InterviewPanelist {
  organizationId String          @map("organization_id") @db.Uuid
  interviewId    String          @map("interview_id") @db.Uuid
  employeeId     String          @map("employee_id") @db.Uuid
  rating         Int?            @db.SmallInt
  recommendation Recommendation?
  notes          String?         @db.VarChar(5000)
  submittedAt    DateTime?       @map("submitted_at") @db.Timestamptz(6)

  interview Interview @relation(fields: [organizationId, interviewId], references: [organizationId, id], onDelete: Cascade)
  employee  Employee  @relation("Panelist", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@id([interviewId, employeeId])
  @@index([organizationId, employeeId])
  @@map("interview_panelists")
}

model Offer {
  id              String      @id @default(uuid(7)) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  applicationId   String      @map("application_id") @db.Uuid
  designationId   String?     @map("designation_id") @db.Uuid
  jobGradeId      String?     @map("job_grade_id") @db.Uuid
  joiningDate     DateTime    @map("joining_date") @db.Date
  annualCtc       Decimal     @map("annual_ctc") @db.Decimal(14, 2)
  currency        String      @default("INR") @db.Char(3)
  notes           String?     @db.VarChar(5000)
  status          OfferStatus @default(DRAFT)
  sentAt          DateTime?   @map("sent_at") @db.Timestamptz(6)
  respondedAt     DateTime?   @map("responded_at") @db.Timestamptz(6)
  createdByUserId String?     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  application JobApplication @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Restrict)
  designation Designation?   @relation(fields: [designationId], references: [id], onDelete: Restrict)
  jobGrade    JobGrade?      @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)

  @@index([organizationId, applicationId])
  @@map("offers")
}

model OnboardingTemplate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(1000)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tasks        OnboardingTemplateTask[]
  plans        OnboardingPlan[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("onboarding_templates")
}

model OnboardingTemplateTask {
  id               String                    @id @default(uuid(7)) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  templateId       String                    @map("template_id") @db.Uuid
  title            String                    @db.VarChar(200)
  description      String?                   @db.VarChar(2000)
  assignee         OnboardingAssignee
  dueOffsetDays    Int                       @map("due_offset_days") @db.SmallInt
  documentCategory EmployeeDocumentCategory? @map("document_category")
  sortOrder        Int                       @default(0) @map("sort_order") @db.SmallInt

  template OnboardingTemplate @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, templateId])
  @@map("onboarding_template_tasks")
}

model OnboardingPlan {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  templateId      String?              @map("template_id") @db.Uuid
  joiningDate     DateTime             @map("joining_date") @db.Date
  status          OnboardingPlanStatus @default(IN_PROGRESS)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee            @relation("OnboardingPlans", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  template OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks    OnboardingTask[]

  @@unique([organizationId, id])
  @@index([organizationId, employeeId])
  @@map("onboarding_plans")
}

model OnboardingTask {
  id                 String                    @id @default(uuid(7)) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  planId             String                    @map("plan_id") @db.Uuid
  title              String                    @db.VarChar(200)
  description        String?                   @db.VarChar(2000)
  assignee           OnboardingAssignee
  assigneeEmployeeId String?                   @map("assignee_employee_id") @db.Uuid
  dueDate            DateTime                  @map("due_date") @db.Date
  documentCategory   EmployeeDocumentCategory? @map("document_category")
  status             OnboardingTaskStatus      @default(PENDING)
  completedAt        DateTime?                 @map("completed_at") @db.Timestamptz(6)
  completedByUserId  String?                   @map("completed_by_user_id") @db.Uuid
  sortOrder          Int                       @default(0) @map("sort_order") @db.SmallInt
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan             OnboardingPlan @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  assigneeEmployee Employee?      @relation("OnboardingAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, planId])
  @@index([organizationId, assigneeEmployeeId, status])
  @@map("onboarding_tasks")
}

// =============================================================================================
// Phase 07 — India payroll (ADR-014). Statutory values are organization configuration in
// statutory_rule_sets; none are seeded.
// =============================================================================================

enum PayableDaysMethod {
  CALENDAR_DAYS
  FIXED_DAYS
  WORKING_DAYS
}

enum StatutoryRuleType {
  EPF
  ESI
  PT
  INCOME_TAX
  GRATUITY
}

enum RuleSetStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum TaxRegime {
  OLD
  NEW
}

enum SalaryComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum ComponentCalcType {
  FIXED
  PERCENT_OF_CTC
  PERCENT_OF_COMPONENT
  BALANCING
}

enum SalaryRevisionReason {
  JOINING
  REVISION
  PROMOTION
  CORRECTION
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  FINALIZED
  CANCELLED
}

enum PayLineCategory {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayLineSource {
  STRUCTURE
  ADJUSTMENT
  ARREARS
  STATUTORY
  SETTLEMENT
}

enum SettlementStatus {
  DRAFT
  CALCULATED
  APPROVED
  FINALIZED
  CANCELLED
}

/// One row per organization: how payable days and loss of pay are counted.
model PayrollSettings {
  organizationId      String            @id @map("organization_id") @db.Uuid
  payableDaysMethod   PayableDaysMethod @default(CALENDAR_DAYS) @map("payable_days_method")
  fixedDays           Int?              @map("fixed_days") @db.SmallInt
  absentIsLossOfPay   Boolean           @default(true) @map("absent_is_loss_of_pay")
  hraComponentCode    String?           @map("hra_component_code") @db.VarChar(20)
  basicComponentCodes String[]          @default([]) @map("basic_component_codes") @db.VarChar(20)
  /// Regime used when an employee has not chosen one for the financial year (organization decision).
  defaultTaxRegime    TaxRegime?        @map("default_tax_regime")
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("payroll_settings")
}

/// Effective-dated statutory configuration (EPF, ESI, PT per state, income tax per regime, gratuity).
/// `config` is validated by @hrm/validation for its type and is immutable once ACTIVE.
model StatutoryRuleSet {
  id                String            @id @default(uuid(7)) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  type              StatutoryRuleType
  name              String            @db.VarChar(200)
  /// PT only: ISO 3166-2:IN code.
  stateCode         String?           @map("state_code") @db.VarChar(6)
  /// INCOME_TAX only.
  regime            TaxRegime?
  effectiveFrom     DateTime          @map("effective_from") @db.Date
  effectiveTo       DateTime?         @map("effective_to") @db.Date
  status            RuleSetStatus     @default(DRAFT)
  sourceReference   String            @map("source_reference") @db.VarChar(1000)
  notes             String?           @db.VarChar(2000)
  config            Json
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid
  activatedByUserId String?           @map("activated_by_user_id") @db.Uuid
  activatedAt       DateTime?         @map("activated_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, type, status, effectiveFrom])
  @@map("statutory_rule_sets")
}

model SalaryComponent {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  code           String              @db.VarChar(20)
  name           String              @db.VarChar(100)
  kind           SalaryComponentKind
  taxable        Boolean             @default(true)
  pfWage         Boolean             @default(false) @map("pf_wage")
  esiWage        Boolean             @default(false) @map("esi_wage")
  ptWage         Boolean             @default(false) @map("pt_wage")
  prorate        Boolean             @default(true)
  payslipOrder   Int                 @default(100) @map("payslip_order") @db.SmallInt
  description    String?             @db.VarChar(500)
  status         RecordStatus        @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  structureLines SalaryStructureComponent[] @relation("StructureComponent")
  baseOfLines    SalaryStructureComponent[] @relation("StructureBaseComponent")

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("salary_components")
}

/// A salary template. Its component lines are immutable after creation (create a new structure to change them),
/// so a salary's breakdown is reproducible.
model SalaryStructure {
  id                     String       @id @default(uuid(7)) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  name                   String       @db.VarChar(100)
  description            String?      @db.VarChar(500)
  employerStatutoryInCtc Boolean      @default(false) @map("employer_statutory_in_ctc")
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  components   SalaryStructureComponent[]
  salaries     EmployeeSalary[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("salary_structures")
}

model SalaryStructureComponent {
  organizationId  String            @map("organization_id") @db.Uuid
  structureId     String            @map("structure_id") @db.Uuid
  componentId     String            @map("component_id") @db.Uuid
  calcType        ComponentCalcType @map("calc_type")
  percent         Decimal?          @db.Decimal(7, 4)
  monthlyAmount   Decimal?          @map("monthly_amount") @db.Decimal(14, 2)
  baseComponentId String?           @map("base_component_id") @db.Uuid
  sortOrder       Int               @default(0) @map("sort_order") @db.SmallInt

  structure     SalaryStructure  @relation(fields: [organizationId, structureId], references: [organizationId, id], onDelete: Cascade)
  component     SalaryComponent  @relation("StructureComponent", fields: [organizationId, componentId], references: [organizationId, id], onDelete: Restrict)
  baseComponent SalaryComponent? @relation("StructureBaseComponent", fields: [baseComponentId], references: [id], onDelete: Restrict)

  @@id([structureId, componentId])
  @@index([organizationId, structureId])
  @@map("salary_structure_components")
}

/// Effective-dated salary of an employee (joining, revisions). A past effective date produces arrears.
model EmployeeSalary {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  structureId     String               @map("structure_id") @db.Uuid
  annualCtc       Decimal              @map("annual_ctc") @db.Decimal(14, 2)
  effectiveFrom   DateTime             @map("effective_from") @db.Date
  reason          SalaryRevisionReason
  note            String?              @db.VarChar(1000)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  employee  Employee        @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  structure SalaryStructure @relation(fields: [organizationId, structureId], references: [organizationId, id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([organizationId, employeeId, effectiveFrom])
  @@map("employee_salaries")
}

model EmployeePayrollProfile {
  employeeId           String   @id @map("employee_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  pfApplicable         Boolean  @default(false) @map("pf_applicable")
  voluntaryPfFullWages Boolean  @default(false) @map("voluntary_pf_full_wages")
  epsEligible          Boolean  @default(true) @map("eps_eligible")
  esiApplicable        Boolean  @default(false) @map("esi_applicable")
  esiNumber            String?  @map("esi_number") @db.VarChar(17)
  ptStateCode          String?  @map("pt_state_code") @db.VarChar(6)
  metroCity            Boolean  @default(false) @map("metro_city")
  taxApplicable        Boolean  @default(true) @map("tax_applicable")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, employeeId])
  @@map("employee_payroll_profiles")
}

/// Regime choice and investment declarations for one financial year.
model TaxDeclaration {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  financialYear   String    @map("financial_year") @db.Char(7)
  regime          TaxRegime
  rentPaidAnnual  Decimal   @default(0) @map("rent_paid_annual") @db.Decimal(14, 2)
  /// Section code → declared annual amount (decimal strings).
  deductions      Json      @default("{}")
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([employeeId, financialYear])
  @@index([organizationId, financialYear])
  @@map("tax_declarations")
}

model PayrollRun {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  year               Int              @db.SmallInt
  month              Int              @db.SmallInt
  periodStart        DateTime         @map("period_start") @db.Date
  periodEnd          DateTime         @map("period_end") @db.Date
  status             PayrollRunStatus @default(DRAFT)
  employeeCount      Int              @default(0) @map("employee_count")
  problemCount       Int              @default(0) @map("problem_count")
  totalGross         Decimal          @default(0) @map("total_gross") @db.Decimal(16, 2)
  totalDeductions    Decimal          @default(0) @map("total_deductions") @db.Decimal(16, 2)
  totalNet           Decimal          @default(0) @map("total_net") @db.Decimal(16, 2)
  totalEmployerCost  Decimal          @default(0) @map("total_employer_cost") @db.Decimal(16, 2)
  note               String?          @db.VarChar(1000)
  createdByUserId    String?          @map("created_by_user_id") @db.Uuid
  calculatedByUserId String?          @map("calculated_by_user_id") @db.Uuid
  calculatedAt       DateTime?        @map("calculated_at") @db.Timestamptz(6)
  approvedByUserId   String?          @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz(6)
  finalizedByUserId  String?          @map("finalized_by_user_id") @db.Uuid
  finalizedAt        DateTime?        @map("finalized_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company             @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  results      PayrollResult[]
  adjustments  PayrollAdjustment[]

  @@unique([organizationId, id])
  @@index([organizationId, companyId, year, month])
  @@map("payroll_runs")
}

/// One-time earnings or deductions for an employee in a run (bonus, incentive, recovery, …).
model PayrollAdjustment {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  runId           String          @map("run_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  code            String          @db.VarChar(20)
  name            String          @db.VarChar(100)
  category        PayLineCategory
  amount          Decimal         @db.Decimal(14, 2)
  taxable         Boolean         @default(true)
  pfWage          Boolean         @default(false) @map("pf_wage")
  esiWage         Boolean         @default(false) @map("esi_wage")
  ptWage          Boolean         @default(false) @map("pt_wage")
  note            String?         @db.VarChar(500)
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  run      PayrollRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Cascade)
  employee Employee   @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, runId, employeeId])
  @@map("payroll_adjustments")
}

/// An employee's computed pay in a run, with the snapshot of every input used (reproducible).
model PayrollResult {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  runId               String   @map("run_id") @db.Uuid
  employeeId          String   @map("employee_id") @db.Uuid
  payableDays         Decimal  @map("payable_days") @db.Decimal(5, 2)
  periodDays          Decimal  @map("period_days") @db.Decimal(5, 2)
  lossOfPayDays       Decimal  @default(0) @map("loss_of_pay_days") @db.Decimal(5, 2)
  gross               Decimal  @db.Decimal(14, 2)
  totalDeductions     Decimal  @map("total_deductions") @db.Decimal(14, 2)
  netPay              Decimal  @map("net_pay") @db.Decimal(14, 2)
  employerCost        Decimal  @map("employer_cost") @db.Decimal(14, 2)
  taxableGross        Decimal  @default(0) @map("taxable_gross") @db.Decimal(14, 2)
  pfWages             Decimal  @default(0) @map("pf_wages") @db.Decimal(14, 2)
  esiWages            Decimal  @default(0) @map("esi_wages") @db.Decimal(14, 2)
  ptWages             Decimal  @default(0) @map("pt_wages") @db.Decimal(14, 2)
  esiCovered          Boolean  @default(false) @map("esi_covered")
  annualTaxProjection Decimal? @map("annual_tax_projection") @db.Decimal(14, 2)
  snapshot            Json
  taxTrace            Json?    @map("tax_trace")
  problems            Json     @default("[]")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run      PayrollRun          @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)
  employee Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  lines    PayrollResultLine[]

  @@unique([runId, employeeId])
  @@unique([organizationId, id])
  @@index([organizationId, employeeId])
  @@map("payroll_results")
}

model PayrollResultLine {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  resultId       String          @map("result_id") @db.Uuid
  code           String          @db.VarChar(24)
  name           String          @db.VarChar(120)
  category       PayLineCategory
  source         PayLineSource
  amount         Decimal         @db.Decimal(14, 2)
  taxable        Boolean         @default(false)
  /// ARREARS lines: the past month the difference belongs to.
  forYear        Int?            @map("for_year") @db.SmallInt
  forMonth       Int?            @map("for_month") @db.SmallInt
  sortOrder      Int             @default(0) @map("sort_order") @db.SmallInt

  result PayrollResult @relation(fields: [organizationId, resultId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, resultId])
  @@map("payroll_result_lines")
}

/// Full & final settlement of a separated employee.
model PayrollSettlement {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  lastWorkingDate    DateTime         @map("last_working_date") @db.Date
  status             SettlementStatus @default(DRAFT)
  inputs             Json
  lines              Json             @default("[]")
  gratuity           Decimal          @default(0) @db.Decimal(14, 2)
  leaveEncashment    Decimal          @default(0) @map("leave_encashment") @db.Decimal(14, 2)
  noticePay          Decimal          @default(0) @map("notice_pay") @db.Decimal(14, 2)
  totalEarnings      Decimal          @default(0) @map("total_earnings") @db.Decimal(14, 2)
  totalDeductions    Decimal          @default(0) @map("total_deductions") @db.Decimal(14, 2)
  netPayable         Decimal          @default(0) @map("net_payable") @db.Decimal(14, 2)
  problems           Json             @default("[]")
  note               String?          @db.VarChar(1000)
  calculatedByUserId String?          @map("calculated_by_user_id") @db.Uuid
  calculatedAt       DateTime?        @map("calculated_at") @db.Timestamptz(6)
  approvedByUserId   String?          @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz(6)
  finalizedByUserId  String?          @map("finalized_by_user_id") @db.Uuid
  finalizedAt        DateTime?        @map("finalized_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("payroll_settlements")
}

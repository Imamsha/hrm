  REORGANIZATION
  REJOINING

  @@map("employment_change_type")
}

enum SeparationType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  CONTRACT_END
  OTHER

  @@map("separation_type")
}

enum AddressType {
  CURRENT
  PERMANENT

  @@map("address_type")
}

enum FamilyRelation {
  SPOUSE
  CHILD

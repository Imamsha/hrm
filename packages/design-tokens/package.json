{
  "name": "@hrm/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/emit-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hrm/eslint-config": "workspace:*",
    "@hrm/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "17.14.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

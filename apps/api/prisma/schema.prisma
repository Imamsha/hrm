/// Per-organization employee numbering (`<prefix><zero-padded number>`).
model EmployeeSettings {
  organizationId String   @id @map("organization_id") @db.Uuid
  numberPrefix   String   @default("EMP-") @map("number_prefix") @db.VarChar(10)
  numberPadding  Int      @default(4) @map("number_padding") @db.SmallInt
  nextNumber     Int      @default(1) @map("next_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("employee_settings")
}

model Employee {
  id               String          @id @default(uuid(7)) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  employeeNumber   String          @map("employee_number") @db.VarChar(30)
  /// Login account in this organization (self-service). Same tenant enforced by trigger.
  membershipId     String?         @unique @map("membership_id") @db.Uuid
  firstName        String          @map("first_name") @db.VarChar(100)
  middleName       String?         @map("middle_name") @db.VarChar(100)
  lastName         String?         @map("last_name") @db.VarChar(100)
  preferredName    String?         @map("preferred_name") @db.VarChar(100)
  workEmail        String?         @map("work_email") @db.Citext
  workPhone        String?         @map("work_phone") @db.VarChar(25)
  personalEmail    String?         @map("personal_email") @db.Citext
  personalPhone    String?         @map("personal_phone") @db.VarChar(25)
  dateOfBirth      DateTime?       @map("date_of_birth") @db.Date
  gender           Gender?
  maritalStatus    MaritalStatus?  @map("marital_status")
  nationality      String?         @db.Char(2)
  dateOfJoining    DateTime        @map("date_of_joining") @db.Date
  probationStatus  ProbationStatus @default(NOT_APPLICABLE) @map("probation_status")
  probationEndDate DateTime?       @map("probation_end_date") @db.Date
  confirmationDate DateTime?       @map("confirmation_date") @db.Date
  noticePeriodDays Int?            @map("notice_period_days") @db.SmallInt
  status           EmployeeStatus  @default(ACTIVE)
  resignationDate  DateTime?       @map("resignation_date") @db.Date
  lastWorkingDate  DateTime?       @map("last_working_date") @db.Date
  separationType   SeparationType? @map("separation_type")
  separationReason String?         @map("separation_reason") @db.VarChar(1000)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership         Membership?                @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  employmentRecords  EmploymentRecord[]         @relation("EmployeeRecords")
  managedRecords     EmploymentRecord[]         @relation("ManagerRecords")
  statutoryIds       EmployeeStatutoryIds?
  addresses          EmployeeAddress[]
  emergencyContacts  EmployeeEmergencyContact[]
  familyMembers      EmployeeFamilyMember[]
  education          EmployeeEducation[]
  experience         EmployeeExperience[]
  certifications     EmployeeCertification[]
  skills             EmployeeSkill[]
  bankAccounts       EmployeeBankAccount[]
  documents          EmployeeDocument[]
  shiftAssignments   ShiftAssignment[]
  rosterEntries      RosterEntry[]
  punches            AttendancePunch[]
  regularizations    AttendanceRegularization[]
  leaveRequests      LeaveRequest[]             @relation("LeaveRequests")
  leaveApprovals     LeaveRequest[]             @relation("LeaveApprovals")
  leaveLedger        LeaveLedgerEntry[]
  hiringOpenings     JobOpening[]               @relation("HiringManager")
  hiredCandidate     Candidate?                 @relation("HiredCandidate")
  panelSeats         InterviewPanelist[]        @relation("Panelist")
  onboardingPlans    OnboardingPlan[]           @relation("OnboardingPlans")
  onboardingTasks    OnboardingTask[]           @relation("OnboardingAssignee")
  salaries           EmployeeSalary[]
  payrollProfile     EmployeePayrollProfile?
  taxDeclarations    TaxDeclaration[]
  payrollAdjustments PayrollAdjustment[]
  payrollResults     PayrollResult[]
  settlements        PayrollSettlement[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, id])
  @@unique([organizationId, workEmail])
  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
  @@map("employees")
}

/// Effective-dated job assignment. Non-overlapping per employee (exclusion constraint).
model EmploymentRecord {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  effectiveFrom   DateTime             @map("effective_from") @db.Date
  /// Inclusive end; NULL = open-ended (current or latest).
  effectiveTo     DateTime?            @map("effective_to") @db.Date
  changeType      EmploymentChangeType @map("change_type")
  employmentType  EmploymentType       @map("employment_type")
  companyId       String               @map("company_id") @db.Uuid
  legalEntityId   String?              @map("legal_entity_id") @db.Uuid
  branchId        String?              @map("branch_id") @db.Uuid
  departmentId    String?              @map("department_id") @db.Uuid
  teamId          String?              @map("team_id") @db.Uuid
  designationId   String?              @map("designation_id") @db.Uuid
  jobGradeId      String?              @map("job_grade_id") @db.Uuid
  costCenterId    String?              @map("cost_center_id") @db.Uuid
  managerId       String?              @map("manager_id") @db.Uuid
  remarks         String?              @db.VarChar(500)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation("EmployeeRecords", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)
  company      Company      @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  legalEntity  LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict)
  jobGrade     JobGrade?    @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  manager      Employee?    @relation("ManagerRecords", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, companyId])
  @@index([organizationId, departmentId])
  @@index([organizationId, branchId])
  @@index([organizationId, managerId])
  @@map("employment_records")
}

/// Encrypted statutory identifiers (AES-256-GCM, context-bound). Never selected by default.
model EmployeeStatutoryIds {
  employeeId     String   @id @map("employee_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  panEncrypted   String?  @map("pan_encrypted")
  panLast4       String?  @map("pan_last4") @db.Char(4)
  uanEncrypted   String?  @map("uan_encrypted")
  uanLast4       String?  @map("uan_last4") @db.Char(4)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, employeeId])
  @@map("employee_statutory_ids")
}

model EmployeeAddress {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  employeeId     String      @map("employee_id") @db.Uuid
  type           AddressType
  line1          String      @db.VarChar(200)
  line2          String?     @db.VarChar(200)
  city           String      @db.VarChar(100)
  state          String?     @db.VarChar(100)
  postalCode     String?     @map("postal_code") @db.VarChar(20)
  countryCode    String      @default("IN") @map("country_code") @db.Char(2)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([employeeId, type])
  @@index([organizationId, employeeId])
  @@map("employee_addresses")
}

model EmployeeEmergencyContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  name           String   @db.VarChar(200)
  relationship   String   @db.VarChar(50)
  phone          String   @db.VarChar(25)
  email          String?  @db.Citext
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("employee_emergency_contacts")
}

model EmployeeFamilyMember {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  name           String         @db.VarChar(200)
  relation       FamilyRelation
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date

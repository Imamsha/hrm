{
  "name": "hrm-enterprise",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise multi-tenant AI-powered HRM SaaS platform",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait && node scripts/check-infra-ports.mjs",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @hrm/api db:generate",
    "db:migrate": "pnpm --filter @hrm/api db:migrate",
    "db:deploy": "pnpm --filter @hrm/api db:deploy",
    "db:status": "pnpm --filter @hrm/api db:status",
    "seed:demo": "pnpm --filter @hrm/api seed:demo"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}

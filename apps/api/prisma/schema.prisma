enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_REQUESTER
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

enum ExitReasonCategory {
  CAREER
  COMPENSATION
  RELOCATION
  PERSONAL
  HEALTH
  STUDIES
  MANAGER
  WORK_CULTURE
  OTHER

  @@map("exit_reason_category")
}

enum ResignationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN

  @@map("resignation_status")
}

enum SeparationCaseStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("separation_case_status")
}

enum ClearanceKind {
  TEMPLATE
  ASSET
  LICENSE
  KNOWLEDGE_TRANSFER

  @@map("clearance_kind")
}

enum ClearanceStatus {
  PENDING
  CLEARED
  WAIVED

  @@map("clearance_status")
}

enum ObligationCategory {
  STATUTORY_FILING
  LICENCE_RENEWAL
  AUDIT
  POLICY_REVIEW
  OTHER

  @@map("obligation_category")
}

enum Recurrence {
  NONE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY

  @@map("recurrence")
}

enum ComplianceTaskStatus {
  OPEN
  COMPLETED

  @@map("compliance_task_status")
}

model HelpdeskSettings {
  organizationId String   @id @map("organization_id") @db.Uuid
  ticketPrefix   String   @default("HD") @map("ticket_prefix") @db.VarChar(10)
  nextSequence   Int      @default(1) @map("next_sequence")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("helpdesk_settings")
}

model HelpdeskCategory {
  id                   String       @id @default(uuid(7)) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  code                 String       @db.VarChar(20)
  name                 String       @db.VarChar(80)
  description          String?      @db.VarChar(500)
  status               RecordStatus @default(ACTIVE)
  confidential         Boolean      @default(false)
  defaultAssigneeId    String?      @map("default_assignee_id") @db.Uuid
  escalationEmployeeId String?      @map("escalation_employee_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agents       HelpdeskAgent[]
  slas         HelpdeskSla[]
  tickets      Ticket[]
  articles     KbArticle[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("helpdesk_categories")
}

model HelpdeskAgent {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid
  employeeId     String @map("employee_id") @db.Uuid

  category HelpdeskCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)
  employee Employee         @relation("HelpdeskAgents", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([categoryId, employeeId])
  @@index([organizationId, employeeId])
  @@map("helpdesk_agents")
}

model HelpdeskSla {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  categoryId         String         @map("category_id") @db.Uuid
  priority           TicketPriority
  firstResponseHours Int?           @map("first_response_hours")
  resolutionHours    Int?           @map("resolution_hours")

  category HelpdeskCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([categoryId, priority])
  @@map("helpdesk_slas")
}

model Ticket {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  number              String         @db.VarChar(30)
  categoryId          String         @map("category_id") @db.Uuid
  requesterEmployeeId String         @map("requester_employee_id") @db.Uuid
  assigneeEmployeeId  String?        @map("assignee_employee_id") @db.Uuid
  subject             String         @db.VarChar(200)
  description         String         @db.VarChar(10000)
  priority            TicketPriority @default(MEDIUM)
  status              TicketStatus   @default(OPEN)
  firstResponseDue    DateTime?      @map("first_response_due") @db.Timestamptz(6)
  resolutionDue       DateTime?      @map("resolution_due") @db.Timestamptz(6)
  firstRespondedAt    DateTime?      @map("first_responded_at") @db.Timestamptz(6)
  resolvedAt          DateTime?      @map("resolved_at") @db.Timestamptz(6)
  closedAt            DateTime?      @map("closed_at") @db.Timestamptz(6)
  resolution          String?        @db.VarChar(2000)
  rating              Int?
  ratingComment       String?        @map("rating_comment") @db.VarChar(1000)
  escalatedAt         DateTime?      @map("escalated_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    HelpdeskCategory   @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  requester   Employee           @relation("TicketRequester", fields: [organizationId, requesterEmployeeId], references: [organizationId, id], onDelete: Restrict)
  assignee    Employee?          @relation("TicketAssignee", fields: [organizationId, assigneeEmployeeId], references: [organizationId, id], onDelete: Restrict)
  comments    TicketComment[]
  events      TicketEvent[]
  attachments TicketAttachment[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, categoryId, status])
  @@index([organizationId, requesterEmployeeId])
  @@index([organizationId, assigneeEmployeeId, status])
  @@map("tickets")
}

model TicketComment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  body           String   @db.VarChar(10000)
  internal       Boolean  @default(false)
  byRequester    Boolean  @default(false) @map("by_requester")
  authorUserId   String?  @map("author_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  action         String   @db.VarChar(40)
  fromValue      String?  @map("from_value") @db.VarChar(200)
  toValue        String?  @map("to_value") @db.VarChar(200)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, ticketId, createdAt])
  @@map("ticket_events")
}

model TicketAttachment {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  storageKey       String   @map("storage_key") @db.VarChar(500)
  fileName         String   @map("file_name") @db.VarChar(255)
  contentType      String   @map("content_type") @db.VarChar(100)
  size             Int
  sha256           String   @db.Char(64)
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [organizationId, ticketId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, ticketId])
  @@map("ticket_attachments")
}

model KbArticle {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  title          String        @db.VarChar(200)
  body           String        @db.VarChar(50000)
  status         ArticleStatus @default(DRAFT)
  authorUserId   String?       @map("author_user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     HelpdeskCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  votes        KbArticleVote[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("kb_articles")
}

model KbArticleVote {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  articleId      String   @map("article_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  helpful        Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  article KbArticle @relation(fields: [organizationId, articleId], references: [organizationId, id], onDelete: Cascade)

  @@unique([articleId, employeeId])
  @@map("kb_article_votes")
}

model SeparationSettings {
  organizationId    String   @id @map("organization_id") @db.Uuid
  /// Null: no notice period configured.
  noticeDays        Int?     @map("notice_days")
  clearanceTemplate Json     @default("[]") @map("clearance_template")
  exitQuestions     Json     @default("[]") @map("exit_questions")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("separation_settings")
}

model Resignation {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  employeeId         String             @map("employee_id") @db.Uuid
  reasonCategory     ExitReasonCategory @map("reason_category")
  note               String?            @db.VarChar(2000)
  submittedOn        DateTime           @map("submitted_on") @db.Date
  requestedLastDay   DateTime           @map("requested_last_day") @db.Date
  noticeLastDay      DateTime?          @map("notice_last_day") @db.Date
  agreedLastDay      DateTime?          @map("agreed_last_day") @db.Date
  waivedNoticeDays   Int                @default(0) @map("waived_notice_days")
  status             ResignationStatus  @default(PENDING)
  approverEmployeeId String?            @map("approver_employee_id") @db.Uuid
  decidedByUserId    String?            @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?            @map("decision_note") @db.VarChar(1000)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee        @relation("Resignations", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  case     SeparationCase?

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("resignations")
}

model SeparationCase {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  employeeId      String               @map("employee_id") @db.Uuid
  resignationId   String?              @map("resignation_id") @db.Uuid
  separationType  SeparationType       @map("separation_type")
  reasonCategory  ExitReasonCategory   @map("reason_category")
  lastWorkingDay  DateTime             @map("last_working_day") @db.Date
  status          SeparationCaseStatus @default(IN_PROGRESS)
  note            String?              @db.VarChar(2000)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee    Employee        @relation("SeparationCases", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  resignation Resignation?    @relation(fields: [organizationId, resignationId], references: [organizationId, id], onDelete: Restrict)
  items       ClearanceItem[]
  interview   ExitInterview?

  @@unique([organizationId, id])
  @@unique([organizationId, resignationId])
  @@index([organizationId, status])
  @@map("separation_cases")
}

model ClearanceItem {
  id                  String          @id @default(uuid(7)) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  caseId              String          @map("case_id") @db.Uuid
  kind                ClearanceKind
  title               String          @db.VarChar(200)
  ownerRoleKey        String?         @map("owner_role_key") @db.VarChar(64)
  ownerEmployeeId     String?         @map("owner_employee_id") @db.Uuid
  assetAllocationId   String?         @unique @map("asset_allocation_id") @db.Uuid
  licenseAssignmentId String?         @unique @map("license_assignment_id") @db.Uuid
  status              ClearanceStatus @default(PENDING)
  note                String?         @db.VarChar(500)
  decidedByUserId     String?         @map("decided_by_user_id") @db.Uuid
  decidedAt           DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  case SeparationCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, caseId])
  @@map("clearance_items")
}

model ExitInterview {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  caseId           String   @map("case_id") @db.Uuid
  questions        Json
  answers          Json
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  byEmployee       Boolean  @map("by_employee")
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  case SeparationCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, caseId])
  @@map("exit_interviews")
}

model ComplianceObligation {
  id              String             @id @default(uuid(7)) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  title           String             @db.VarChar(200)
  category        ObligationCategory
  description     String?            @db.VarChar(2000)
  ownerEmployeeId String             @map("owner_employee_id") @db.Uuid
  firstDueOn      DateTime           @map("first_due_on") @db.Date
  recurrence      Recurrence
  status          RecordStatus       @default(ACTIVE)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        Employee         @relation("ComplianceOwner", fields: [organizationId, ownerEmployeeId], references: [organizationId, id], onDelete: Restrict)
  tasks        ComplianceTask[]

  @@unique([organizationId, id])
  @@map("compliance_obligations")
}

model ComplianceTask {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  obligationId      String               @map("obligation_id") @db.Uuid
  dueOn             DateTime             @map("due_on") @db.Date
  status            ComplianceTaskStatus @default(OPEN)
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?              @map("completed_by_user_id") @db.Uuid
  note              String?              @db.VarChar(2000)
  evidenceKey       String?              @map("evidence_key") @db.VarChar(500)
  evidenceName      String?              @map("evidence_name") @db.VarChar(255)
  evidenceSize      Int?                 @map("evidence_size")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  obligation ComplianceObligation @relation(fields: [organizationId, obligationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([obligationId, dueOn])
  @@index([organizationId, status, dueOn])
  @@map("compliance_tasks")
}

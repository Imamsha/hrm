  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([employeeId, name])
  @@index([organizationId, name])
  @@map("employee_skills")
}

model EmployeeBankAccount {
  id                     String          @id @default(uuid(7)) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  employeeId             String          @map("employee_id") @db.Uuid
  accountHolderName      String          @map("account_holder_name") @db.VarChar(200)
  bankName               String          @map("bank_name") @db.VarChar(200)
  branchName             String?         @map("branch_name") @db.VarChar(200)

model RatingScale {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(100)
  /// [{value, label, description}] ascending.
  points         Json
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  templates    ReviewTemplate[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("rating_scales")
}

model Competency {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(30)
  name           String       @db.VarChar(100)
  description    String?      @db.VarChar(1000)
  category       String?      @db.VarChar(60)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("competencies")
}

model ReviewTemplate {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  name               String       @db.VarChar(100)
  ratingScaleId      String       @map("rating_scale_id") @db.Uuid
  goalsWeightPercent Decimal      @map("goals_weight_percent") @db.Decimal(5, 2)
  /// [{competencyId, weight}]
  competencies       Json         @default("[]")
  /// [{id, text, required}]
  questions          Json         @default("[]")
  includeSelf        Boolean      @map("include_self")
  includeManager     Boolean      @map("include_manager")
  peerMin            Int          @map("peer_min") @db.SmallInt
  peerMax            Int          @map("peer_max") @db.SmallInt
  includeUpward      Boolean      @map("include_upward")
  anonymityMinimum   Int          @map("anonymity_minimum") @db.SmallInt
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ratingScale  RatingScale   @relation(fields: [organizationId, ratingScaleId], references: [organizationId, id], onDelete: Restrict)
  cycles       ReviewCycle[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("review_templates")
}

model ReviewCycle {
  id                   String            @id @default(uuid(7)) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  name                 String            @db.VarChar(120)
  templateId           String            @map("template_id") @db.Uuid
  /// Template and scale as they were at launch (later template edits never change a cycle).
  templateSnapshot     Json?             @map("template_snapshot")
  periodStart          DateTime          @map("period_start") @db.Date
  periodEnd            DateTime          @map("period_end") @db.Date
  selfDueOn            DateTime?         @map("self_due_on") @db.Date
  managerDueOn         DateTime?         @map("manager_due_on") @db.Date
  audienceCompanyId    String?           @map("audience_company_id") @db.Uuid
  audienceDepartmentId String?           @map("audience_department_id") @db.Uuid

  status                  LibraryDocumentStatus @default(PUBLISHED)
  audienceCompanyId       String?               @map("audience_company_id") @db.Uuid
  audienceDepartmentId    String?               @map("audience_department_id") @db.Uuid
  currentVersion          Int                   @default(1) @map("current_version")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions         LibraryDocumentVersion[]
  acknowledgements LibraryAcknowledgement[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("library_documents")
}

model LibraryDocumentVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  version         Int
  storageKey      String   @map("storage_key") @db.VarChar(500)
  fileName        String   @map("file_name") @db.VarChar(255)
  contentType     String   @map("content_type") @db.VarChar(100)
  size            Int
  sha256          String   @db.Char(64)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document LibraryDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([documentId, version])
  @@map("library_document_versions")
}

model LibraryAcknowledgement {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  version        Int
  employeeId     String   @map("employee_id") @db.Uuid
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  document LibraryDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)
  employee Employee        @relation("LibraryAcknowledgements", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([documentId, version, employeeId])
  @@map("library_acknowledgements")
}

// =============================================================================================
// Phase 11b — Helpdesk, separation & offboarding, compliance (ADR-019)

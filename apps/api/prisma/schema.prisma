  employee Employee        @relation("TravelRequests", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  bookings TravelBooking[]
  advances TravelAdvance[]
  claims   ExpenseClaim[]

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status])
  @@map("travel_requests")
}

model TravelBooking {

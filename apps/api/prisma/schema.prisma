}

model ExpenseClaim {
  id                     String             @id @default(uuid(7)) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  employeeId             String             @map("employee_id") @db.Uuid
  title                  String             @db.VarChar(200)
  tripId                 String?            @map("trip_id") @db.Uuid
  status                 ExpenseClaimStatus @default(DRAFT)
  totalClaimed           Decimal            @default(0) @map("total_claimed") @db.Decimal(14, 2)
  totalApproved          Decimal?           @map("total_approved") @db.Decimal(14, 2)
  /// Routing: the reporting manager at submission (null = HR verifies directly).
  approverEmployeeId     String?            @map("approver_employee_id") @db.Uuid
  payoutMethod           PayoutMethod?      @map("payout_method")
  submittedAt            DateTime?          @map("submitted_at") @db.Timestamptz(6)
  managerDecidedByUserId String?            @map("manager_decided_by_user_id") @db.Uuid
  managerDecidedAt       DateTime?          @map("manager_decided_at") @db.Timestamptz(6)
  financeDecidedByUserId String?            @map("finance_decided_by_user_id") @db.Uuid
  financeDecidedAt       DateTime?          @map("finance_decided_at") @db.Timestamptz(6)
  decisionNote           String?            @map("decision_note") @db.VarChar(1000)
  /// Payroll run carrying the reimbursement (PAYROLL payout).
  payrollRunId           String?            @map("payroll_run_id") @db.Uuid
  paidOn                 DateTime?          @map("paid_on") @db.Date
  paidReference          String?            @map("paid_reference") @db.VarChar(100)
  reimbursedAt           DateTime?          @map("reimbursed_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee            @relation("ExpenseClaims", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  trip     TravelRequest?      @relation(fields: [tripId], references: [id], onDelete: Restrict)
  items    ExpenseItem[]
  events   ExpenseClaimEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, status])
  @@index([organizationId, approverEmployeeId, status])
  @@map("expense_claims")
}

model ExpenseItem {
  id                 String   @id @default(uuid(7)) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  claimId            String   @map("claim_id") @db.Uuid
  categoryId         String   @map("category_id") @db.Uuid
  date               DateTime @db.Date
  days               Int      @default(1) @db.SmallInt
  description        String   @db.VarChar(300)
  merchant           String?  @db.VarChar(200)
  currency           String   @db.Char(3)
  originalAmount     Decimal  @map("original_amount") @db.Decimal(14, 2)
  exchangeRate       Decimal  @map("exchange_rate") @db.Decimal(14, 6)
  /// In the organization's currency (original × rate).
  amount             Decimal  @db.Decimal(14, 2)
  approvedAmount     Decimal? @map("approved_amount") @db.Decimal(14, 2)
  financeNote        String?  @map("finance_note") @db.VarChar(500)
  justification      String?  @db.VarChar(1000)
  /// Policy warnings at submission (kept for approvers).
  issues             Json     @default("[]")
  receiptStorageKey  String?  @unique @map("receipt_storage_key") @db.VarChar(500)
  receiptFileName    String?  @map("receipt_file_name") @db.VarChar(255)
  receiptContentType String?  @map("receipt_content_type") @db.VarChar(100)
  receiptSizeBytes   Int?     @map("receipt_size_bytes")
  sortOrder          Int      @default(0) @map("sort_order") @db.SmallInt

  claim    ExpenseClaim    @relation(fields: [organizationId, claimId], references: [organizationId, id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, claimId])
  @@index([organizationId, categoryId, date])
  @@map("expense_items")
}

model ExpenseClaimEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  claimId        String              @map("claim_id") @db.Uuid

// HRM platform database schema.
// Conventions (docs/database/CONVENTIONS.md):
//   - snake_case tables/columns via @@map/@map, camelCase in TypeScript.
//   - UUIDv7 primary keys (time-ordered -> better B-tree locality than v4).
//   - timestamptz everywhere; numeric (never float) for money.
//   - Every tenant-owned table has organization_id and an RLS policy (see migrations).
//   - Check constraints, RLS policies, triggers and functions live in migration SQL
//     because Prisma schema language cannot express them.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum AuditActorType {
  USER
  SYSTEM
  API_CLIENT
  AI_AGENT

  @@map("audit_actor_type")
}

/// Tenant root. Every tenant-owned row references an organization.
model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  /// URL-safe unique handle, case-insensitive.
  slug            String             @unique @db.Citext
  name            String             @db.VarChar(200)
  legalName       String?            @map("legal_name") @db.VarChar(300)
  status          OrganizationStatus @default(ACTIVE)
  /// IANA time zone, e.g. Asia/Kolkata.
  defaultTimezone String             @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(64)
  /// ISO 4217 currency code.
  defaultCurrency String             @default("INR") @map("default_currency") @db.Char(3)
  /// BCP 47 locale tag.
  defaultLocale   String             @default("en-IN") @map("default_locale") @db.VarChar(35)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)

  auditLogs       AuditLog[]
  memberships     Membership[]
  roles           Role[]
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]
  invitations     Invitation[]
  subscription    Subscription?
  activeSessions  Session[]

  companies        Company[]
  legalEntities    LegalEntity[]
  locations        Location[]
  branches         Branch[]
  costCenters      CostCenter[]
  departments      Department[]
  teams            Team[]
  jobGrades        JobGrade[]
  designations     Designation[]
  workWeeks        WorkWeek[]
  workWeekRules    WorkWeekRule[]
  holidayCalendars HolidayCalendar[]
  holidays         Holiday[]

  @@index([status])
  @@map("organizations")
}

/// Append-only audit trail. UPDATE/DELETE are blocked by a trigger.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  /// Dotted verb, e.g. `organization.updated`.
  action         String         @db.VarChar(100)
  entityType     String         @map("entity_type") @db.VarChar(100)
  entityId       String?        @map("entity_id") @db.VarChar(64)
  requestId      String?        @map("request_id") @db.VarChar(64)
  ipAddress      String?        @map("ip_address") @db.Inet
  userAgent      String?        @map("user_agent") @db.VarChar(512)
  /// Field-level before/after diff. Sensitive values must be redacted before writing.
  changes        Json?
  metadata       Json?
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId])
  @@map("audit_logs")
}

// =============================================================================================
// Identity (global, not tenant-owned). Accessed only through identity services.
// =============================================================================================

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A person who can sign in. One user may belong to many organizations (memberships).
model User {
  id                    String     @id @default(uuid(7)) @db.Uuid
  email                 String     @unique @db.Citext
  fullName              String     @map("full_name") @db.VarChar(200)
  /// argon2id PHC string. Never returned by any API.
  passwordHash          String     @map("password_hash")
  status                UserStatus @default(ACTIVE)
  emailVerifiedAt       DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  mfaEnabled            Boolean    @default(false) @map("mfa_enabled")
  /// TOTP secret encrypted with AES-256-GCM (DATA_ENCRYPTION_KEY). Null until enrolment starts.
  mfaSecretEncrypted    String?    @map("mfa_secret_encrypted")
  /// SHA-256 hashes of unused one-time recovery codes.
  mfaRecoveryCodeHashes String[]   @default([]) @map("mfa_recovery_code_hashes")
  failedLoginCount      Int        @default(0) @map("failed_login_count")
  lockedUntil           DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt           DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  sessions            Session[]
  authEvents          AuthEvent[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// A signed-in device/browser. Refresh tokens rotate within a session; reuse revokes the session.
model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  /// Organization selected in this session; re-validated against memberships on every request.
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  userAgent            String?   @map("user_agent") @db.VarChar(512)
  ipAddress            String?   @map("ip_address") @db.Inet
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt           DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  /// Absolute lifetime; refresh cannot extend beyond it.
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason         String?   @map("revoke_reason") @db.VarChar(50)

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization?  @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the opaque token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when exchanged for a new token. Presenting a used token again = theft signal.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum AuthEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGIN_LOCKED
  MFA_CHALLENGE_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  MFA_RECOVERY_CODE_USED
  ORGANIZATION_SWITCHED
  SESSION_REVOKED

  @@map("auth_event_type")
}

/// Security audit / login history (append-only).
model AuthEvent {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  /// Attempted e-mail for failures against unknown accounts.
  email      String?       @db.Citext
  type       AuthEventType
  sessionId  String?       @map("session_id") @db.Uuid
  ipAddress  String?       @map("ip_address") @db.Inet
  userAgent  String?       @map("user_agent") @db.VarChar(512)
  requestId  String?       @map("request_id") @db.VarChar(64)
  metadata   Json?
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([email, occurredAt(sort: Desc)])
  @@map("auth_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =============================================================================================
// Tenant access control (tenant-owned, RLS). Composite FKs prevent cross-tenant references.
// =============================================================================================

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@map("memberships")
}

/// Global permission catalog (seeded by migrations; mirrors `PERMISSIONS` in @hrm/shared-types).
model Permission {
  key         String @id @db.VarChar(100)
  module      String @db.VarChar(50)
  description String @db.VarChar(300)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Stable machine key, unique per organization (system roles: owner, admin, hr_admin, ...).
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  /// System roles are created for every organization and cannot be renamed or deleted.
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions     RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@map("roles")
}

model RolePermission {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionKey  String @map("permission_key") @db.VarChar(100)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([organizationId])
  @@map("role_permissions")
}

/// ABAC scope of a role assignment. Only ORGANIZATION and SELF are evaluated until the
/// organization structure (companies, branches, departments, teams) exists in Phase 03.
enum AccessScopeType {
  ORGANIZATION
  COMPANY
  BRANCH
  DEPARTMENT
  TEAM
  SELF

  @@map("access_scope_type")
}

model MembershipRole {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  membershipId   String          @map("membership_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  scopeType      AccessScopeType @default(ORGANIZATION) @map("scope_type")
  scopeId        String?         @map("scope_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  /// Created in SQL with NULLS NOT DISTINCT (scope_id NULL values compare equal).
  @@unique([membershipId, roleId, scopeType, scopeId], map: "membership_roles_assignment_key")
  @@index([organizationId, membershipId])
  @@index([organizationId, roleId])
  @@map("membership_roles")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("invitation_status")
}

model Invitation {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String           @db.Citext
  fullName        String?          @map("full_name") @db.VarChar(200)
  /// Roles granted on acceptance (validated against the organization's roles at acceptance time).
  roleIds         String[]         @map("role_ids") @db.Uuid
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("invitations")
}

// =============================================================================================
// Subscriptions
// =============================================================================================

/// Global plan catalog (seeded). Prices are intentionally not modelled until billing is designed.
model SubscriptionPlan {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// Feature/usage limits, e.g. { "maxMembers": 25 }. Null value = unlimited.
  limits      Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// =============================================================================================
// Organization structure (Phase 03). Tenant-owned, RLS. Required parents use composite
// (organization_id, id) foreign keys; optional references use a plain FK plus the
// app.enforce_same_tenant() trigger (Prisma cannot model optional composite FKs).
// =============================================================================================

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

model Company {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  code            String       @db.VarChar(20)
  name            String       @db.VarChar(200)
  /// ISO 3166-1 alpha-2.
  countryCode     String       @default("IN") @map("country_code") @db.Char(2)
  /// Overrides the organization default when set.
  defaultCurrency String?      @map("default_currency") @db.Char(3)
  timezone        String?      @db.VarChar(64)
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntities LegalEntity[]
  branches      Branch[]
  departments   Department[]
  costCenters   CostCenter[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("companies")
}

model LegalEntity {
  id                   String       @id @default(uuid(7)) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  companyId            String       @map("company_id") @db.Uuid
  code                 String       @db.VarChar(20)
  legalName            String       @map("legal_name") @db.VarChar(300)
  countryCode          String       @default("IN") @map("country_code") @db.Char(2)
  /// India: Permanent Account Number.
  pan                  String?      @db.Char(10)
  /// India: Tax Deduction and Collection Account Number.
  tan                  String?      @db.Char(10)
  /// India: GST Identification Number.
  gstin                String?      @db.Char(15)
  /// India: Corporate Identification Number.
  cin                  String?      @db.Char(21)
  /// Registration number for non-Indian jurisdictions.
  registrationNumber   String?      @map("registration_number") @db.VarChar(50)
  registeredLocationId String?      @map("registered_location_id") @db.Uuid
  status               RecordStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company      @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  registeredLocation Location?    @relation(fields: [registeredLocationId], references: [id], onDelete: Restrict)
  branches           Branch[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, companyId])
  @@map("legal_entities")
}

model Location {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(200)
  addressLine1   String       @map("address_line1") @db.VarChar(200)
  addressLine2   String?      @map("address_line2") @db.VarChar(200)
  city           String       @db.VarChar(100)
  state          String?      @db.VarChar(100)
  postalCode     String?      @map("postal_code") @db.VarChar(20)
  countryCode    String       @default("IN") @map("country_code") @db.Char(2)
  timezone       String?      @db.VarChar(64)
  /// WGS84 coordinates (geofencing in Phase 05).
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches      Branch[]
  legalEntities LegalEntity[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("locations")
}

model Branch {
  id                String       @id @default(uuid(7)) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  legalEntityId     String?      @map("legal_entity_id") @db.Uuid
  locationId        String?      @map("location_id") @db.Uuid
  code              String       @db.VarChar(20)
  name              String       @db.VarChar(200)
  timezone          String?      @db.VarChar(64)
  workWeekId        String?      @map("work_week_id") @db.Uuid
  holidayCalendarId String?      @map("holiday_calendar_id") @db.Uuid
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company         Company          @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  legalEntity     LegalEntity?     @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  workWeek        WorkWeek?        @relation(fields: [workWeekId], references: [id], onDelete: Restrict)
  holidayCalendar HolidayCalendar? @relation(fields: [holidayCalendarId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, companyId])
  @@map("branches")
}

model CostCenter {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments  Department[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("cost_centers")
}

model Department {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  /// Parent department (sub-departments). Cycles are rejected by a trigger.
  parentId       String?      @map("parent_id") @db.Uuid
  costCenterId   String?      @map("cost_center_id") @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[] @relation("DepartmentTree")
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  teams        Team[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, companyId])
  @@index([organizationId, parentId])
  @@map("departments")
}

model Team {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  departmentId   String       @map("department_id") @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, departmentId])
  @@map("teams")
}

model JobGrade {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(100)
  /// Seniority order: 1 = most junior. Unique per organization.
  rank           Int
  description    String?      @db.VarChar(500)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  designations Designation[]

  @@unique([organizationId, code])
  @@unique([organizationId, rank])
  @@unique([organizationId, id])
  @@map("job_grades")
}

model Designation {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  jobGradeId     String?      @map("job_grade_id") @db.Uuid
  code           String       @db.VarChar(20)
  /// Job title, e.g. "Senior Software Engineer".
  name           String       @db.VarChar(200)
  description    String?      @db.VarChar(1000)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobGrade     JobGrade?    @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("designations")
}

enum DayType {
  FULL
  HALF
  OFF

  @@map("day_type")
}

/// Working-days pattern ("work week"), e.g. Mon–Fri, or Mon–Sat with 2nd/4th Saturday off.
model WorkWeek {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  /// Used for branches without an explicit work week. At most one per organization.
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rules        WorkWeekRule[]
  branches     Branch[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("work_weeks")
}

model WorkWeekRule {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  workWeekId     String  @map("work_week_id") @db.Uuid
  /// ISO weekday 1 (Mon) – 7 (Sun).
  weekday        Int     @db.SmallInt
  /// 0 = every occurrence; 1–5 = nth occurrence in the month.
  occurrence     Int     @default(0) @db.SmallInt
  dayType        DayType @map("day_type")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workWeek     WorkWeek     @relation(fields: [organizationId, workWeekId], references: [organizationId, id], onDelete: Cascade)

  @@unique([workWeekId, weekday, occurrence])
  @@index([organizationId])
  @@map("work_week_rules")
}

enum HolidayKind {
  PUBLIC
  OPTIONAL

  @@map("holiday_kind")
}

model HolidayCalendar {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  /// Used for branches without an explicit calendar. At most one per organization.
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  holidays     Holiday[]
  branches     Branch[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("holiday_calendars")
}

model Holiday {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  calendarId     String      @map("calendar_id") @db.Uuid
  date           DateTime    @db.Date
  name           String      @db.VarChar(200)
  kind           HolidayKind @default(PUBLIC)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  calendar     HolidayCalendar @relation(fields: [organizationId, calendarId], references: [organizationId, id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([organizationId, date])
  @@map("holidays")
}

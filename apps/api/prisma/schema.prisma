model EmployeeSkill {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  employeeId     String     @map("employee_id") @db.Uuid
  name           String     @db.Citext
  level          SkillLevel
  years          Int?       @db.SmallInt

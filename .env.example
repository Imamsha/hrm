# Copy to `.env` for local development. Never commit real secrets.
# All values below are development-only defaults that match docker-compose.yml.

# ---------- Docker Compose ----------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
POSTGRES_DB=hrm
POSTGRES_HOST_PORT=5434
HRM_MIGRATOR_PASSWORD=migrator_dev_only
HRM_APP_PASSWORD=app_dev_only
REDIS_HOST_PORT=6380
REDIS_PASSWORD=redis_dev_only
STORAGE_HOST_PORT=9000
STORAGE_CONSOLE_HOST_PORT=9001
SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# ---------- API runtime ----------
# NODE_ENV is not set here: Vite would apply it to production web builds. The API defaults to development.
API_PORT=3100
API_PUBLIC_URL=http://localhost:3100
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5180,http://localhost:4173,http://localhost:8081
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# Runtime connection: least-privileged role subject to Row-Level Security.
DATABASE_URL=postgresql://hrm_app:app_dev_only@localhost:5434/hrm?schema=public
# Migration connection: schema owner. Used only by Prisma CLI / CI, never by the running API.
MIGRATION_DATABASE_URL=postgresql://hrm_migrator:migrator_dev_only@localhost:5434/hrm?schema=public
DATABASE_POOL_MAX=10

REDIS_URL=redis://:redis_dev_only@localhost:6380/0

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=hrm_storage_dev
STORAGE_SECRET_KEY=hrm_storage_dev_secret
STORAGE_BUCKET=hrm-dev
STORAGE_FORCE_PATH_STYLE=true
# Creates the bucket on boot. Development only; production buckets are provisioned by IaC.
STORAGE_AUTO_CREATE_BUCKET=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=HRM Platform <no-reply@hrm.local>

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300

# ---------- Integration tests (isolated database, Redis DB and bucket) ----------
TEST_DATABASE_URL=postgresql://hrm_app:app_dev_only@localhost:5434/hrm_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://hrm_migrator:migrator_dev_only@localhost:5434/hrm_test?schema=public
TEST_REDIS_URL=redis://:redis_dev_only@localhost:6380/1
TEST_STORAGE_BUCKET=hrm-test

# ---------- AI (optional; AI features stay disabled until configured) ----------
# Provider id: `openai-compatible` or `disabled`.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1536
AI_REQUEST_TIMEOUT_MS=60000

# ---------- Web (Vite) ----------
VITE_API_BASE_URL=http://localhost:3100/api/v1

# ---------- Mobile (Expo) ----------
# Android emulator reaches the host via 10.0.2.2; physical devices need your LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3100/api/v1

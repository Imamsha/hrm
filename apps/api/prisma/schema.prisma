model SuggestionVote {
  organizationId String   @map("organization_id") @db.Uuid
  suggestionId   String   @map("suggestion_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  suggestion Suggestion @relation(fields: [organizationId, suggestionId], references: [organizationId, id], onDelete: Cascade)

  @@id([suggestionId, employeeId])
  @@map("suggestion_votes")
}

// =============================================================================================
// Phase 10 — Clients & projects (ADR-017)
// =============================================================================================

enum BillingType {
  TIME_AND_MATERIALS
  FIXED_FEE
  NON_BILLABLE

  @@map("billing_type")
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER

  @@map("project_role")
}

enum BoardCategory {
  TODO
  IN_PROGRESS
  DONE

  @@map("board_category")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED

  @@map("sprint_status")
}

enum WorkItemType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
  SUBTASK

  @@map("work_item_type")
}

enum WorkItemPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST

  @@map("work_item_priority")
}

enum BugSeverity {
  MINOR
  MAJOR
  CRITICAL
  BLOCKER

  @@map("bug_severity")
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED

  @@map("timesheet_status")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID

  @@map("invoice_status")
}

enum InvoiceLineSource {
  TIME
  MANUAL

  @@map("invoice_line_source")
}

model Client {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  code             String       @db.VarChar(20)
  name             String       @db.VarChar(200)
  currency         String       @db.Char(3)
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  billingAddress   String?      @map("billing_address") @db.VarChar(1000)
  taxNumber        String?      @map("tax_number") @db.VarChar(40)
  email            String?      @db.VarChar(254)
  notes            String?      @db.VarChar(2000)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts     ClientContact[]
  portalUsers  ClientPortalUser[]
  projects     Project[]
  invoices     Invoice[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("clients")
}

model ClientContact {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  name           String   @db.VarChar(120)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(30)
  role           String?  @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@map("client_contacts")
}

/// Links a member holding the `client` role to the one client whose portal they see.
model ClientPortalUser {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client     Client     @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Cascade)
  membership Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@index([organizationId, clientId])
  @@map("client_portal_users")
}

model Project {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  key             String        @db.VarChar(10)
  name            String        @db.VarChar(200)
  description     String?       @db.VarChar(5000)
  clientId        String?       @map("client_id") @db.Uuid
  billingType     BillingType   @map("billing_type")
  hourlyRate      Decimal?      @map("hourly_rate") @db.Decimal(14, 2)
  budgetAmount    Decimal?      @map("budget_amount") @db.Decimal(14, 2)
  budgetHours     Decimal?      @map("budget_hours") @db.Decimal(10, 2)
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  status          ProjectStatus @default(ACTIVE)
  portalEnabled   Boolean       @default(false) @map("portal_enabled")
  /// Next work item number (`KEY-n`); incremented under a row lock, never reused.
  nextItemNumber  Int           @default(1) @map("next_item_number")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?         @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  members      ProjectMember[]
  columns      BoardColumn[]
  sprints      Sprint[]
  workItems    WorkItem[]
  timeEntries  TimeEntry[]
  invoiceLines InvoiceLine[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, clientId])
  @@map("projects")
}

model ProjectMember {
  id                String      @id @default(uuid(7)) @db.Uuid
  organizationId    String      @map("organization_id") @db.Uuid
  projectId         String      @map("project_id") @db.Uuid
  employeeId        String      @map("employee_id") @db.Uuid
  role              ProjectRole @default(MEMBER)
  billingRate       Decimal?    @map("billing_rate") @db.Decimal(14, 2)
  allocationPercent Decimal?    @map("allocation_percent") @db.Decimal(7, 4)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  Project  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  employee Employee @relation("ProjectMemberships", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)

  @@unique([projectId, employeeId])
  @@index([organizationId, employeeId])
  @@map("project_members")
}

model BoardColumn {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  name           String        @db.VarChar(40)
  category       BoardCategory
  position       Int
  wipLimit       Int?          @map("wip_limit")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  workItems WorkItem[]

  @@unique([organizationId, id])
  @@index([organizationId, projectId, position])
  @@map("board_columns")
}

model Sprint {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  name            String       @db.VarChar(80)
  goal            String?      @db.VarChar(1000)
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date
  status          SprintStatus @default(PLANNED)
  committedPoints Decimal?     @map("committed_points") @db.Decimal(8, 1)
  completedPoints Decimal?     @map("completed_points") @db.Decimal(8, 1)
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   Project    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  workItems WorkItem[]

  @@unique([organizationId, id])
  @@index([organizationId, projectId, status])
  @@map("sprints")
}

model WorkItem {
  id                 String           @id @default(uuid(7)) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  projectId          String           @map("project_id") @db.Uuid
  number             Int
  type               WorkItemType
  title              String           @db.VarChar(300)
  description        String?          @db.VarChar(20000)
  parentId           String?          @map("parent_id") @db.Uuid
  columnId           String           @map("column_id") @db.Uuid
  priority           WorkItemPriority @default(MEDIUM)
  assigneeEmployeeId String?          @map("assignee_employee_id") @db.Uuid
  reporterUserId     String?          @map("reporter_user_id") @db.Uuid
  /// Raised through the client portal.
  fromClient         Boolean          @default(false) @map("from_client")
  sprintId           String?          @map("sprint_id") @db.Uuid
  storyPoints        Decimal?         @map("story_points") @db.Decimal(5, 1)
  estimateHours      Decimal?         @map("estimate_hours") @db.Decimal(9, 2)
  dueDate            DateTime?        @map("due_date") @db.Date
  labels             String[]         @default([]) @db.VarChar(30)
  severity           BugSeverity?
  stepsToReproduce   String?          @map("steps_to_reproduce") @db.VarChar(5000)
  environment        String?          @db.VarChar(300)
  clientVisible      Boolean          @default(false) @map("client_visible")
  rank               Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project     Project           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  parent      WorkItem?         @relation("WorkItemTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children    WorkItem[]        @relation("WorkItemTree")
  column      BoardColumn       @relation(fields: [organizationId, columnId], references: [organizationId, id], onDelete: Restrict)
  assignee    Employee?         @relation("WorkItemAssignee", fields: [organizationId, assigneeEmployeeId], references: [organizationId, id], onDelete: Restrict)
  sprint      Sprint?           @relation(fields: [organizationId, sprintId], references: [organizationId, id], onDelete: Restrict)
  comments    WorkItemComment[]
  events      WorkItemEvent[]
  timeEntries TimeEntry[]

  @@unique([projectId, number])
  @@unique([organizationId, id])
  @@index([organizationId, projectId, columnId, rank])
  @@index([organizationId, sprintId])
  @@index([organizationId, assigneeEmployeeId])
  @@index([organizationId, parentId])
  @@map("work_items")
}

model WorkItemComment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workItemId     String   @map("work_item_id") @db.Uuid
  body           String   @db.VarChar(10000)
  clientVisible  Boolean  @default(false) @map("client_visible")
  fromClient     Boolean  @default(false) @map("from_client")
  authorUserId   String?  @map("author_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workItem WorkItem @relation(fields: [organizationId, workItemId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workItemId, createdAt])
  @@map("work_item_comments")
}

model WorkItemEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workItemId     String   @map("work_item_id") @db.Uuid
  field          String   @db.VarChar(40)
  fromValue      String?  @map("from_value") @db.VarChar(300)
  toValue        String?  @map("to_value") @db.VarChar(300)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workItem WorkItem @relation(fields: [organizationId, workItemId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workItemId, createdAt])
  @@map("work_item_events")
}

model Timesheet {
  id                 String          @id @default(uuid(7)) @db.Uuid
  organizationId     String          @map("organization_id") @db.Uuid
  employeeId         String          @map("employee_id") @db.Uuid
  weekStart          DateTime        @map("week_start") @db.Date
  status             TimesheetStatus @default(DRAFT)
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approverEmployeeId String?         @map("approver_employee_id") @db.Uuid
  decidedByUserId    String?         @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?       @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?         @map("decision_note") @db.VarChar(500)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee    @relation("EmployeeTimesheets", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  approver Employee?   @relation("TimesheetApprover", fields: [organizationId, approverEmployeeId], references: [organizationId, id], onDelete: Restrict)
  entries  TimeEntry[]

  @@unique([employeeId, weekStart])
  @@unique([organizationId, id])
  @@index([organizationId, status, weekStart])
  @@index([organizationId, approverEmployeeId, status])
  @@map("timesheets")
}

model TimeEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  timesheetId    String   @map("timesheet_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  workItemId     String?  @map("work_item_id") @db.Uuid
  date           DateTime @db.Date
  hours          Decimal  @db.Decimal(5, 2)
  billable       Boolean  @default(true)
  note           String?  @db.VarChar(500)
  /// Set when the entry is billed; cleared when that invoice is voided.
  invoiceLineId  String?  @map("invoice_line_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  timesheet   Timesheet    @relation(fields: [organizationId, timesheetId], references: [organizationId, id], onDelete: Restrict)
  project     Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  workItem    WorkItem?    @relation(fields: [organizationId, workItemId], references: [organizationId, id], onDelete: Restrict)
  invoiceLine InvoiceLine? @relation(fields: [organizationId, invoiceLineId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, projectId, date])
  @@index([organizationId, employeeId, date])
  @@index([organizationId, timesheetId])
  @@index([organizationId, invoiceLineId])
  @@map("time_entries")
}

model TaxRate {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(60)
  ratePercent    Decimal   @map("rate_percent") @db.Decimal(7, 4)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoiceLines InvoiceLine[]

  @@unique([organizationId, id])
  @@index([organizationId, name])
  @@map("tax_rates")
}

model BillingSettings {
  organizationId String   @id @map("organization_id") @db.Uuid
  invoicePrefix  String   @default("INV") @map("invoice_prefix") @db.VarChar(10)
  nextSequence   Int      @default(1) @map("next_sequence")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("billing_settings")
}

model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  clientId        String        @map("client_id") @db.Uuid
  number          String?       @db.VarChar(30)
  currency        String        @db.Char(3)
  status          InvoiceStatus @default(DRAFT)
  issuedOn        DateTime?     @map("issued_on") @db.Date
  dueOn           DateTime?     @map("due_on") @db.Date
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total           Decimal       @default(0) @db.Decimal(14, 2)
  paidTotal       Decimal       @default(0) @map("paid_total") @db.Decimal(14, 2)
  notes           String?       @db.VarChar(2000)
  voidReason      String?       @map("void_reason") @db.VarChar(500)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(6)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  client   Client           @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments InvoicePayment[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, clientId, status])
  @@map("invoices")
}

model InvoiceLine {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  invoiceId      String            @map("invoice_id") @db.Uuid
  position       Int
  source         InvoiceLineSource
  projectId      String?           @map("project_id") @db.Uuid
  description    String            @db.VarChar(500)
  quantity       Decimal           @db.Decimal(12, 2)
  unitPrice      Decimal           @map("unit_price") @db.Decimal(14, 2)
  amount         Decimal           @db.Decimal(14, 2)
  taxRateId      String?           @map("tax_rate_id") @db.Uuid
  taxName        String?           @map("tax_name") @db.VarChar(60)
  taxPercent     Decimal?          @map("tax_percent") @db.Decimal(7, 4)
  tax            Decimal           @default(0) @db.Decimal(14, 2)
  total          Decimal           @db.Decimal(14, 2)

  invoice     Invoice     @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)
  project     Project?    @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  taxRate     TaxRate?    @relation(fields: [organizationId, taxRateId], references: [organizationId, id], onDelete: Restrict)
  timeEntries TimeEntry[]

  @@unique([invoiceId, position])
  @@unique([organizationId, id])
  @@map("invoice_lines")
}

model InvoicePayment {
  id               String   @id @default(uuid(7)) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  invoiceId        String   @map("invoice_id") @db.Uuid
  amount           Decimal  @db.Decimal(14, 2)
  receivedOn       DateTime @map("received_on") @db.Date
  reference        String?  @db.VarChar(100)
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@map("invoice_payments")
}

// =============================================================================================
// Phase 11a — Workflow engine, documents and e-acceptance (ADR-018)
// =============================================================================================

enum WorkflowProcess {
  LEAVE_REQUEST
  EXPENSE_CLAIM
  TRAVEL_REQUEST
  TIMESHEET
  RESIGNATION

  @@map("workflow_process")
}

enum WorkflowInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("workflow_instance_status")
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  CANCELLED

  @@map("workflow_task_status")
}

enum TemplateCategory {
  OFFER_LETTER
  APPOINTMENT_LETTER
  EXPERIENCE_LETTER
  RELIEVING_LETTER
  SALARY_CERTIFICATE
  POLICY
  OTHER

  @@map("template_category")
}

enum GeneratedDocumentStatus {
  FINAL
  AWAITING_ACCEPTANCE
  ACCEPTED
  DECLINED

  @@map("generated_document_status")
}

enum SignerKind {
  EMPLOYEE
  CANDIDATE

  @@map("signer_kind")
}

enum SignerStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("signer_status")
}

enum SignatureMethod {
  LOGIN
  EMAIL_OTP

  @@map("signature_method")
}

enum LibraryDocumentStatus {
  PUBLISHED
  ARCHIVED

  @@map("library_document_status")
}

model WorkflowDefinition {
  id              String          @id @default(uuid(7)) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  process         WorkflowProcess
  name            String          @db.VarChar(120)
  status          RecordStatus    @default(INACTIVE)
  steps           Json
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instances    WorkflowInstance[]

  @@unique([organizationId, id])
  @@index([organizationId, process, status])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  definitionId        String                 @map("definition_id") @db.Uuid
  process             WorkflowProcess
  /// The request the instance approves (leave request, claim, trip or timesheet id).
  subjectId           String                 @map("subject_id") @db.Uuid
  requesterEmployeeId String                 @map("requester_employee_id") @db.Uuid
  measure             Decimal                @db.Decimal(14, 2)
  /// The definition's steps as they were when the request was submitted.
  snapshot            Json
  status              WorkflowInstanceStatus @default(PENDING)
  completedAt         DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  definition WorkflowDefinition @relation(fields: [organizationId, definitionId], references: [organizationId, id], onDelete: Restrict)
  requester  Employee           @relation("WorkflowRequester", fields: [organizationId, requesterEmployeeId], references: [organizationId, id], onDelete: Restrict)
  tasks      WorkflowTask[]

  @@unique([organizationId, id])
  @@index([organizationId, process, subjectId])
  @@map("workflow_instances")
}

model WorkflowTask {
  id                      String             @id @default(uuid(7)) @db.Uuid
  organizationId          String             @map("organization_id") @db.Uuid
  instanceId              String             @map("instance_id") @db.Uuid
  /// Index of the step in the snapshot, and its 1-based position among applicable steps.
  stepIndex               Int                @map("step_index")
  stepNumber              Int                @map("step_number")
  stepName                String             @map("step_name") @db.VarChar(80)
  status                  WorkflowTaskStatus @default(PENDING)
  /// Who may decide (several for a role step; one approval is enough).
  assigneeIds             String[]           @map("assignee_ids") @db.Uuid
  onBehalfOfEmployeeId    String?            @map("on_behalf_of_employee_id") @db.Uuid
  escalatedFromEmployeeId String?            @map("escalated_from_employee_id") @db.Uuid
  dueAt                   DateTime?          @map("due_at") @db.Timestamptz(6)
  skippedReason           String?            @map("skipped_reason") @db.VarChar(200)
  decidedByUserId         String?            @map("decided_by_user_id") @db.Uuid
  decidedByEmployeeId     String?            @map("decided_by_employee_id") @db.Uuid
  decidedAt               DateTime?          @map("decided_at") @db.Timestamptz(6)
  note                    String?            @db.VarChar(500)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  instance WorkflowInstance @relation(fields: [organizationId, instanceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([instanceId, stepIndex])
  @@index([organizationId, status])
  @@index([organizationId, instanceId])
  @@map("workflow_tasks")
}

model ApprovalDelegation {
  id                  String            @id @default(uuid(7)) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  delegatorEmployeeId String            @map("delegator_employee_id") @db.Uuid
  delegateEmployeeId  String            @map("delegate_employee_id") @db.Uuid
  fromDate            DateTime          @map("from_date") @db.Date
  toDate              DateTime          @map("to_date") @db.Date
  /// Empty = every process.
  processes           WorkflowProcess[]
  note                String?           @db.VarChar(300)
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  delegator Employee @relation("DelegationsGiven", fields: [organizationId, delegatorEmployeeId], references: [organizationId, id], onDelete: Restrict)
  delegate  Employee @relation("DelegationsReceived", fields: [organizationId, delegateEmployeeId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, delegatorEmployeeId, fromDate])
  @@map("approval_delegations")
}

model DocumentTemplate {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(120)
  category       TemplateCategory
  status         RecordStatus     @default(ACTIVE)
  currentVersion Int              @default(1) @map("current_version")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     DocumentTemplateVersion[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("document_templates")
}

model DocumentTemplateVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  version         Int
  title           String   @db.VarChar(200)
  body            String   @db.VarChar(50000)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  template  DocumentTemplate    @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict)
  documents GeneratedDocument[]

  @@unique([templateId, version])
  @@unique([organizationId, id])
  @@map("document_template_versions")
}

model GeneratedDocument {
  id                String                  @id @default(uuid(7)) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  templateVersionId String                  @map("template_version_id") @db.Uuid
  category          TemplateCategory
  title             String                  @db.VarChar(200)
  employeeId        String?                 @map("employee_id") @db.Uuid
  offerId           String?                 @map("offer_id") @db.Uuid
  storageKey        String                  @map("storage_key") @db.VarChar(500)
  sha256            String                  @db.Char(64)
  fileSize          Int                     @map("file_size")
  /// The merge values used, for traceability.
  mergedValues      Json                    @map("merged_values")
  status            GeneratedDocumentStatus @default(FINAL)
  certificateKey    String?                 @map("certificate_key") @db.VarChar(500)
  certificateSha256 String?                 @map("certificate_sha256") @db.Char(64)
  createdByUserId   String?                 @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  templateVersion DocumentTemplateVersion @relation(fields: [organizationId, templateVersionId], references: [organizationId, id], onDelete: Restrict)
  employee        Employee?               @relation("GeneratedDocuments", fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  signers         DocumentSigner[]

  @@unique([organizationId, id])
  @@index([organizationId, employeeId])
  @@index([organizationId, offerId])
  @@map("generated_documents")
}

model DocumentSigner {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  documentId      String           @map("document_id") @db.Uuid
  order           Int
  kind            SignerKind
  employeeId      String?          @map("employee_id") @db.Uuid
  name            String           @db.VarChar(200)
  email           String?          @db.VarChar(254)
  status          SignerStatus     @default(PENDING)
  method          SignatureMethod?
  signedAt        DateTime?        @map("signed_at") @db.Timestamptz(6)
  ip              String?          @db.VarChar(64)
  userAgent       String?          @map("user_agent") @db.VarChar(500)
  /// The document hash the signer accepted.
  acceptedSha256  String?          @map("accepted_sha256") @db.Char(64)
  declineReason   String?          @map("decline_reason") @db.VarChar(500)
  /// Candidate link (hash of the e-mailed token) and one-time code.
  accessTokenHash String?          @unique @map("access_token_hash") @db.Char(64)
  otpHash         String?          @map("otp_hash") @db.Char(64)
  otpExpiresAt    DateTime?        @map("otp_expires_at") @db.Timestamptz(6)
  otpAttempts     Int              @default(0) @map("otp_attempts")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  document GeneratedDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([documentId, order])
  @@index([organizationId, employeeId, status])
  @@map("document_signers")
}

model LibraryDocument {
  id                      String                @id @default(uuid(7)) @db.Uuid

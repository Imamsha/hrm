{
  "name": "@hrm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HRM platform REST API (NestJS)",
  "scripts": {
    "postinstall": "prisma generate --no-hints",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ./scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@hrm/business-rules": "workspace:*",
    "@hrm/shared-types": "workspace:*",
    "@hrm/validation": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.3.1",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hrm/eslint-config": "workspace:*",
    "@hrm/typescript-config": "workspace:*",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.16.0",
    "@types/supertest": "7.2.1",
    "eslint": "catalog:",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}

  returnNote        String?         @map("return_note") @db.VarChar(500)
  allocatedByUserId String?         @map("allocated_by_user_id") @db.Uuid
  returnedByUserId  String?         @map("returned_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  asset    Asset    @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
